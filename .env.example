# Copy to .env (git-ignored). Every key is optional in dev; defaults live in
# config/settings/base.py. Never commit real secrets.

# --- Core ---
# DJANGO_SETTINGS_MODULE=config.settings.dev   # .production / .test
# ENVIRONMENT=development        # production in the prod image
# DEBUG=True                     # dev.py defaults to True; never set in prod
# Required in production: python -c "import secrets; print(secrets.token_urlsafe(50))"
# SECRET_KEY=
# Required in production, and it must name real hosts (never '*'): dev hosts are
# fixed in dev.py. Keep localhost: the Docker healthcheck calls /healthz/ with
# Host: localhost.
ALLOWED_HOSTS=localhost,127.0.0.1

# Dev and production both reach the database over the container network as
# "db"; no host port is published.
DATABASE_URL=postgresql://postgres:postgres@db:5432/leynor

# --- Channel publishing ---
# Empty values keep the publisher unavailable; nothing is posted without both.
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
# Public base URL a channel can fetch rendered media from (S3/CDN host).
PUBLIC_MEDIA_BASE_URL=

# --- Media storage (django-storages; one Storage API for every backend) ---
# local (default) | s3 | azure | gcs. Setting it explicitly wins; otherwise a
# complete AWS_* set below selects s3. azure/gcs also need their extra:
# `uv add "django-storages[azure]"` (or [google]) plus that provider's settings.
# STORAGE_BACKEND=

# S3: all three or none (otherwise local disk).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
# S3-compatible provider (R2, B2, MinIO...). Leave empty for AWS.
AWS_S3_ENDPOINT_URL=
# Browser-facing endpoint when AWS_S3_ENDPOINT_URL is cluster-internal.
AWS_S3_PUBLIC_ENDPOINT_URL=

# Required in production: https origin(s) behind the TLS proxy. http:// or a
# missing value stops the app from booting (every POST would be a CSRF 403).
# CSRF_TRUSTED_ORIGINS=https://example.com

# --- Email (production; dev prints to the console) ---
# Resend API if set; otherwise any SMTP server via EMAIL_URL.
RESEND_API_KEY=
# EMAIL_URL=smtp+tls://user:password@smtp.example.com:587
# Required in production: a sender verified with your provider.
# DEFAULT_FROM_EMAIL=hello@example.com
# SERVER_EMAIL=                  # error mails; defaults to DEFAULT_FROM_EMAIL

# --- Observability (opt-in) ---
SENTRY_DSN=
OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_SERVICE_NAME=leynor

# --- App identity ---
# One declaration. Templates, page titles, the API title and the OTel service
# name all read it. APP_SLUG defaults to the lowercased name.
# Shown in page titles, the app shell, the API title and the OTel service.
APP_NAME=Leynor
# Names containers, networks, volumes, the database and the queues. Compose
# reads this file too, so both the app and the stack need only these two lines.
APP_SLUG=leynor

# --- Leynor pipeline ---
# Reel artifacts live in a private S3 bucket, never MEDIA_URL; the reel page
# streams them through an authenticated view. Dev compose and the stack run
# SeaweedFS as service `s3` and set these; any S3 service works.
# APP_ARTIFACT_ENDPOINT_URL=http://s3:8333
# APP_ARTIFACT_BUCKET=artifacts
# APP_ARTIFACT_ACCESS_KEY=
# APP_ARTIFACT_SECRET_KEY=
# APP_ARTIFACT_REGION=us-east-1
# Language models are configured in the admin: AI → Providers, Models,
# Assignments. This Fernet key encrypts their API keys at rest. Required in
# production; development derives one from SECRET_KEY when it is empty.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# APP_SECRETS_KEY=
APP_WHISPER_SIZE=base.en
APP_RENDER_QUALITY=delivery
APP_MIN_FREE_GB=10

# --- Queues ---
# One Q_CLUSTER dict, two processes: the default worker and the heavy worker.
# timeout is a hard per-task limit; retry must exceed it.
# Q_CLUSTER_ROLE=default
# Q_CLUSTER_WORKERS=2
# Q_CLUSTER_TIMEOUT=1500
# Q_CLUSTER_RETRY=1800
